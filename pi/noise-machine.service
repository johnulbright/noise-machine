[Unit]
Description=Brown noise generator
Wants=sound.target noise-mixer.service
After=sound.target noise-mixer.service

# sound.target is listed in BOTH Wants= and After=: an After= alone is inert,
# because ordering only applies when the other unit is actually in the boot
# transaction. Even so, neither target guarantees the device node exists, so the
# generator retries snd_pcm_open() once a second forever rather than relying on
# ordering. That retry loop -- not a dependency, and certainly not the old
# `ExecStartPre=/bin/sleep 2` -- is what makes the cold-boot race safe.

# No start rate limit. StartLimitBurst=5 with RestartSec=5 is what bricked the
# previous build: any persistent fault burned all five attempts in ~28 s and
# systemd then parked the unit in `failed` forever, with no timer or socket to
# ever retry it. An appliance must never reach a state a human has to clear.
StartLimitIntervalSec=0

[Service]
# Type=notify, not simple. Type=simple reports the unit active at fork(),
# before the process has even parsed its options, so a wedged player kept the
# unit green while the speaker was silent. The generator now sends READY=1
# only after its first successful write to the sound device, and WATCHDOG=1
# every period after that, so a hang is detected and restarted.
Type=notify
NotifyAccess=main
WatchdogSec=10s

# The generator retries snd_pcm_open() once a second forever, and only sends
# READY=1 after its first successful write. With the default 90 s
# TimeoutStartSec, a device that is slow to appear would get the process killed
# mid-retry and restarted, accomplishing nothing but a 90-second thrash cycle.
# The retry loop IS the dependency mechanism here, so let it own the waiting.
# The running state is still covered by WatchdogSec above.
TimeoutStartSec=infinity

ExecStart=/usr/local/bin/noise --config /etc/noise-machine.conf

# Restart=always, not on-failure. on-failure does not fire on exit code 0 or on
# SIGTERM/SIGINT/SIGHUP/SIGPIPE, and several realistic paths end the process
# cleanly -- after which the unit shows `inactive (dead)` rather than `failed`,
# so even `systemctl status` looks benign while the room is silent.
Restart=always
RestartSec=1

User=noise
Group=noise
SupplementaryGroups=audio

# The generator needs a few hundred microseconds per period but must never miss
# one. It spends its life blocked in snd_pcm_writei, so SCHED_FIFO cannot spin a
# core. Priority 20 sits below the kernel's own realtime threads.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=20
LimitRTPRIO=20
LimitMEMLOCK=infinity
IOSchedulingClass=realtime
IOSchedulingPriority=2

# Do not let the OOM killer pick this process. There is nothing else on the box
# worth keeping alive, and with zram swap a reclaim stall is the likelier risk.
OOMScoreAdjust=-900

# It needs the sound device, its config file, and nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=no
RestrictAddressFamilies=AF_UNIX

# THREE DIRECTIVES DELIBERATELY LEFT OFF, all defence-in-depth, all of which can
# silently stop audio and none of which could be tested before deployment.
# Enable them one at a time AFTER the service is confirmed working, checking
# `systemctl status noise-machine` and `journalctl -u noise-machine` each time.
#
#   DeviceAllow=char-alsa rw
#     Looks additive; is not. systemd.resource-control(5) says DevicePolicy=auto
#     (the default) "allows access to all devices if no explicit DeviceAllow= is
#     present" -- so adding one entry flips the effective policy to `closed`.
#     That should still be sufficient (closed permits /dev/null, /dev/zero,
#     /dev/full, /dev/random and /dev/urandom, and char-alsa covers /dev/snd/*),
#     but if anything else is needed the device simply fails to open.
#
#   MemoryDenyWriteExecute=yes
#     libasound dlopen()s plugin modules. Ordinary dlopen does not need W+X and
#     this is widely used with hardened services, but a failure here surfaces as
#     snd_pcm_open failing forever in the retry loop, which is a confusing way
#     to find out.
#
#   SystemCallFilter=@system-service
#     Does not clearly cover mlockall and sched_setscheduler across kernel
#     versions. A filter that silently blocks those would quietly remove the
#     realtime guarantees this unit exists to provide.

[Install]
WantedBy=multi-user.target
