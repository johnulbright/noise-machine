[Unit]
Description=Set the audio mixer level for the noise machine
Wants=sound.target
After=sound.target
Before=noise-machine.service

[Service]
Type=oneshot
RemainAfterExit=yes

# 0 dB, NOT 100%.
#
# The bcm2835 "PCM Playback Volume" control has a raw range of -10239..+400 in
# hundredths of a dB, so its maximum is +4.00 dB, not unity. The previous build
# asked for 100% and fed it a file normalized to 0 dBFS, so the firmware applied
# +4 dB of digital gain to an already-full-scale signal and hard-clipped roughly
# 1 % of every sample it played.
#
# This runs as root in its own unit rather than as an ExecStartPre hack inside
# the player, so it is ordered explicitly, it survives a read-only root (no
# alsactl state file needed), and it FAILS LOUDLY if the control name or card
# name is wrong instead of hiding behind `2>/dev/null || true`.
#
# CARD_NAME is substituted by pi/setup.sh from the card this machine actually
# has. Check it with: aplay -l
#
# Two lines, deliberately: setting the level is the part that must not fail
# silently, so it has no '-' prefix. Not every control has a mute switch (many
# I2S DAC boards have no mixer at all), so the unmute is prefixed with '-' and
# a failure there is tolerated.
ExecStart=/usr/bin/amixer -c CARD_NAME sset PCM 0dB
ExecStart=-/usr/bin/amixer -c CARD_NAME sset PCM unmute

[Install]
WantedBy=multi-user.target
